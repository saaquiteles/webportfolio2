{
  "name": "webportfolio2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run content",
    "build": "next build",
    "prebuild": "npm run content",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:hooks && npm run build",
    "content": "velite build --strict",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run content",
    "test:hooks": "node --test .claude/hooks/guards.test.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run content"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "velite": "^0.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "velite": {
      "sharp": "^0.35.5"
    }
  }
}
